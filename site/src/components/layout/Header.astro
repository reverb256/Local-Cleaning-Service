---
/**
 * Header.astro — sticky, glass-blur, mobile-collapse.
 */
import { brand } from '~/lib/brand';
import SkipLink from './SkipLink.astro';

const nav = [
  { label: 'Services', href: '/services' },
  { label: 'About',    href: '/about' },
  { label: 'Quote',    href: '/quote' },
  { label: 'Contact',  href: '/contact' },
];

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<SkipLink />
<header
  class="sticky top-0 inset-x-0 z-30 backdrop-blur-md bg-white/80
         border-b border-ink-200/70 supports-[backdrop-filter]:bg-white/60"
>
  <div class="container-page flex items-center h-16">
    <a
      href="/"
      class="flex items-center gap-2 font-display text-lg font-semibold"
      aria-label={`${brand.name} — homepage`}
    >
      <span
        class="inline-block w-7 h-7 rounded-md bg-gradient-to-br
               from-brand-400 to-brand-600 shadow-cta"
        aria-hidden="true"
      ></span>
      <span>{brand.shortName}</span>
    </a>

    <nav
      class="ml-auto hidden md:flex items-center gap-1"
      aria-label="Primary"
    >
      {
        nav.map((item) => {
          const active = currentPath === item.href
            || (item.href !== '/' && currentPath.startsWith(item.href));
          return (
            <a
              href={item.href}
              class:list={[
                'px-3 py-2 rounded-full text-sm font-medium transition-colors duration-150',
                active
                  ? 'text-brand-700 bg-brand-50'
                  : 'text-ink-700 hover:text-brand-700 hover:bg-brand-50/60',
              ]}
              aria-current={active ? 'page' : undefined}
            >
              {item.label}
            </a>
          );
        })
      }
      <a
        href={`tel:${brand.phone.tel}`}
        class="ml-3 inline-flex items-center gap-2 rounded-pill
               bg-ink-900 px-4 py-2 text-sm font-semibold text-white
               shadow-card hover:bg-ink-800 transition-colors duration-150"
        aria-label={`Call ${brand.phone.display}`}
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="currentColor"
          class="w-4 h-4"
          aria-hidden="true"
        >
          <path d="M6.62 10.79a15.05 15.05 0 0 0 6.59 6.59l2.2-2.2a1 1 0 0 1 1.02-.24c1.12.37 2.33.57 3.57.57a1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.24.2 2.45.57 3.57a1 1 0 0 1-.25 1.02l-2.2 2.2Z" />
        </svg>
        <span>{brand.phone.display}</span>
      </a>
    </nav>

    <details class="md:hidden ml-auto relative">
      <summary
        class="list-none cursor-pointer inline-flex items-center
               justify-center w-10 h-10 rounded-full bg-ink-100
               border border-ink-200"
        aria-label="Toggle menu"
      >
        <svg viewBox="0 0 24 24" class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 6h18M3 12h18M3 18h18" />
        </svg>
      </summary>

      <div
        class="absolute right-0 mt-2 w-64 rounded-card bg-white border border-ink-200
               shadow-card overflow-hidden"
      >
        <ul class="py-2">
          {
            nav.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="block px-4 py-3 text-ink-800 hover:bg-brand-50"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
          <li class="border-t border-ink-200 mt-1 pt-1">
            <a
              href={`tel:${brand.phone.tel}`}
              class="block px-4 py-3 font-semibold text-brand-700"
            >
              Call {brand.phone.display}
            </a>
          </li>
        </ul>
      </div>
    </details>
  </div>
</header>
