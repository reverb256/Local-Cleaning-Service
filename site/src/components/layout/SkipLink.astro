---
/**
 * SkipLink.astro — WCAG-required skip-to-main link.
 * Visually hidden until focused via keyboard.
 */
---

<a
  href="#main"
  class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3
         focus:z-50 focus:inline-flex focus:items-center focus:gap-2
         focus:rounded-pill focus:bg-brand-600 focus:px-4 focus:py-2
         focus:text-white focus:shadow-card"
>
  Skip to main content
</a>
