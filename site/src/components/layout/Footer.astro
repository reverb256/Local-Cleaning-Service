---
/**
 * Footer.astro — closing element on every page.
 * Dark surface, four columns: brand / nav / contact / service area.
 */
import { brand } from '~/lib/brand';

const year = new Date().getFullYear();
---

<footer class="bg-ink-950 text-ink-200 mt-24">
  <div class="container-page py-14 grid gap-10 md:grid-cols-4">
    <div>
      <p class="font-display text-xl text-white">{brand.shortName}</p>
      <p class="mt-3 text-sm text-ink-400 max-w-[20rem]">
        {brand.tagline}
      </p>
      <p class="mt-4 text-xs text-ink-500">
        Bonded · WCB-covered · $2M liability
      </p>
    </div>

    <div>
      <p class="text-xs uppercase tracking-wider text-ink-400">Pages</p>
      <ul class="mt-3 space-y-2 text-sm">
        <li><a class="hover:text-brand-300" href="/services">Services</a></li>
        <li><a class="hover:text-brand-300" href="/about">About</a></li>
        <li><a class="hover:text-brand-300" href="/quote">Get a quote</a></li>
        <li><a class="hover:text-brand-300" href="/contact">Contact</a></li>
        <li><a class="hover:text-brand-300" href="/privacy">Privacy</a></li>
      </ul>
    </div>

    <div>
      <p class="text-xs uppercase tracking-wider text-ink-400">Contact</p>
      <ul class="mt-3 space-y-2 text-sm">
        <li>
          <a class="hover:text-brand-300" href={`tel:${brand.phone.tel}`}>
            {brand.phone.display}
          </a>
        </li>
        <li>
          <a class="hover:text-brand-300" href={`mailto:${brand.email}`}>
            {brand.email}
          </a>
        </li>
        <li class="text-ink-400 not-italic">
          {brand.address.street}<br />
          {brand.address.city}, {brand.address.region} {brand.address.postal}
        </li>
      </ul>

      <p class="mt-4 text-xs uppercase tracking-wider text-ink-400">Hours</p>
      <ul class="mt-2 text-sm text-ink-300 space-y-0.5">
        <li>Mon–Fri · 8 AM – 6 PM</li>
        <li>Saturday · 9 AM – 4 PM</li>
        <li class="text-ink-500">Sunday · closed</li>
      </ul>
    </div>

    <div>
      <p class="text-xs uppercase tracking-wider text-ink-400">Service area</p>
      <ul class="mt-3 flex flex-wrap gap-2 text-xs">
        {
          brand.serviceArea.map((area) => (
            <li class="rounded-pill bg-ink-900 border border-ink-800 px-2.5 py-1 text-ink-300">
              {area}
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div class="border-t border-ink-800">
    <div
      class="container-page py-6 flex flex-col md:flex-row gap-3
             items-start md:items-center justify-between text-xs text-ink-500"
    >
      <p>© {year} {brand.name}. All rights reserved.</p>
      <p class="text-ink-600">
        Member: Winnipeg Chamber of Commerce · CCPPP-certified.
      </p>
    </div>
  </div>
</footer>
