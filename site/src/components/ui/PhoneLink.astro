---
/**
 * PhoneLink.astro — single reusable phone CTA.
 * Three variants:
 *   - "inline"   →  text link inside a sentence
 *   - "cta"      →  button-styled, used in heroes / CTA regions
 *   - "sticky"   →  mobile floating action button, hidden on this page
 *                   footer in view (IntersectionObserver — 7-line script)
 */
import { brand } from '~/lib/brand';

interface Props {
  variant?: 'inline' | 'cta' | 'sticky';
  label?: string;
  class?: string;
}

const {
  variant = 'inline',
  label = `Call ${brand.phone.display}`,
  class: extraClass = '',
} = Astro.props;
---

{
  variant === 'sticky' && (
    <a
      id="phone-fab"
      href={`tel:${brand.phone.tel}`}
      class:list={[
        'fixed bottom-5 right-5 z-40 md:hidden',
        'flex items-center justify-center gap-2',
        'rounded-pill bg-brand-600 text-white px-5 h-14',
        'shadow-cta font-semibold',
        'transition-transform duration-200',
        'hover:scale-105 active:scale-95',
        'min-w-[180px]',
        extraClass,
      ]}
      aria-label={label}
      data-sticky-phone
    >
      <svg
        viewBox="0 0 24 24"
        fill="currentColor"
        class="w-5 h-5"
        aria-hidden="true"
      >
        <path d="M6.62 10.79a15.05 15.05 0 0 0 6.59 6.59l2.2-2.2a1 1 0 0 1 1.02-.24c1.12.37 2.33.57 3.57.57a1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.24.2 2.45.57 3.57a1 1 0 0 1-.25 1.02l-2.2 2.2Z" />
      </svg>
      <span>Call {brand.phone.display}</span>
    </a>

    <!-- hide when footer is in view -->
    <script>
      const fab = document.getElementById('phone-fab');
      if (fab) {
        const footer = document.querySelector('footer');
        if (footer && 'IntersectionObserver' in window) {
          const io = new IntersectionObserver(
            (entries) => {
              for (const e of entries) {
                fab.style.transform = e.isIntersecting
                  ? 'translateY(120%)'
                  : 'translateY(0)';
              }
            },
            { rootMargin: '0px 0px -10% 0px' },
          );
          io.observe(footer);
        }
      }
    </script>
  )
}

{
  variant === 'cta' && (
    <a
      href={`tel:${brand.phone.tel}`}
      class:list={[
        'inline-flex items-center justify-center gap-2',
        'rounded-pill bg-brand-600 text-white px-6 h-12',
        'shadow-cta font-semibold',
        'transition-transform duration-200',
        'hover:scale-105 active:scale-95',
        extraClass,
      ]}
      aria-label={label}
    >
      <svg
        viewBox="0 0 24 24"
        fill="currentColor"
        class="w-5 h-5"
        aria-hidden="true"
      >
        <path d="M6.62 10.79a15.05 15.05 0 0 0 6.59 6.59l2.2-2.2a1 1 0 0 1 1.02-.24c1.12.37 2.33.57 3.57.57a1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.24.2 2.45.57 3.57a1 1 0 0 1-.25 1.02l-2.2 2.2Z" />
      </svg>
      <span>Call {brand.phone.display}</span>
    </a>
  )
}

{
  variant === 'inline' && (
    <a
      href={`tel:${brand.phone.tel}`}
      class:list={[
        'font-semibold text-brand-700 underline underline-offset-4 decoration-2',
        'hover:text-brand-800',
        extraClass,
      ]}
      aria-label={label}
    >
      {brand.phone.display}
    </a>
  )
}
