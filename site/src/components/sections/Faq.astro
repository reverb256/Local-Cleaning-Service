---
/**
 * Faq.astro — collapsible Q&A.
 *
 * Native <details> / <summary> so the accordions work without JS
 * (progressive enhancement). Animation is intentionally absent;
 * <details> toggle is its own affordance.
 */
import { faqs } from '~/content/faqs';
import { Reveal } from '~/components/ui/Reveal.tsx';
---

<section id="faq" class="container-page py-20 md:py-24 max-w-3xl">
  <Reveal client:load>
    <span class="eyebrow">Honest answers</span>
  </Reveal>

  <Reveal client:load delay={0.05}>
    <h2 class="mt-3 font-display text-3xl md:text-4xl text-ink-900">
      Six questions property managers ask first.
    </h2>
  </Reveal>

  <div class="mt-8 divide-y divide-ink-200 border-y border-ink-200">
    {
      faqs.map((faq, idx) => (
        <Reveal client:load delay={0.03 * idx}>
          <details
            class="group py-5 [&>summary]:cursor-pointer"
            open={idx === 0}
          >
            <summary
              class="flex items-start justify-between gap-6
                     text-ink-900 font-semibold list-none"
            >
              <span class="font-display text-lg">{faq.question}</span>
              <span
                class="inline-flex w-7 h-7 rounded-full bg-ink-100
                       text-ink-700 items-center justify-center
                       transition-transform duration-200
                       group-open:rotate-45 shrink-0 mt-0.5"
                aria-hidden="true"
              >
                +
              </span>
            </summary>
            <p class="mt-3 text-ink-700 leading-relaxed">
              {faq.answer}
            </p>
          </details>
        </Reveal>
      ))
    }
  </div>
</section>
