---
/**
 * Hero.astro — first impression.
 *
 * One-screen, two-column:
 *   - Left:  eyebrow, H1, subhead, dual CTA, guarantee pill
 *   - Right: 30-min guarantee + 3-stat strip
 *
 * Tailwind for layout; no JS islands here — the Hero is server-rendered
 * so the LCP shot is plain HTML + preloaded fonts.
 */
import { brand } from '~/lib/brand';
import PhoneLink from '~/components/ui/PhoneLink.astro';
import { Reveal } from '~/components/ui/Reveal.tsx';
---

<section
  class="relative isolate overflow-hidden bg-gradient-to-br
         from-brand-50 via-white to-ink-50"
>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 -z-10
           bg-[radial-gradient(60%_50%_at_70%_30%,rgba(6,182,212,0.18)_0%,transparent_70%)]"
  >
  </div>

  <div class="container-page pt-16 pb-20 md:pt-24 md:pb-28 grid lg:grid-cols-2 gap-12 items-center">
    <Reveal client:load>
      <span class="eyebrow inline-flex items-center gap-2">
        <span class="w-1.5 h-1.5 bg-brand-500 rounded-pill"></span>
        Since {brand.founded} · Winnipeg, MB
      </span>

      <h1 class="mt-4 font-display text-4xl sm:text-5xl lg:text-6xl text-ink-900">
        A workplace you actually want to
        <span class="text-brand-700">come back to tomorrow.</span>
      </h1>

      <p class="mt-5 text-lg text-ink-700 max-w-xl">
        Bonded, WCB-covered, and ready in <strong>30&nbsp;minutes</strong>.
        We clean offices, medical clinics, retail floors, and post-construction
        sites across Winnipeg — with the same crew, on the same checklist,
        every visit.
      </p>

      <div class="mt-7 flex flex-col sm:flex-row gap-3 sm:items-center">
        <a
          href="/quote"
          class="inline-flex items-center justify-center gap-2
                 rounded-pill bg-brand-600 text-white px-7 h-14
                 font-semibold shadow-cta hover:bg-brand-700
                 hover:scale-[1.02] active:scale-[0.98]
                 transition-transform"
        >
          Get a 30-second estimate
          <svg viewBox="0 0 20 20" fill="currentColor" class="w-5 h-5" aria-hidden="true">
            <path fill-rule="evenodd" d="M3 10a.75.75 0 0 1 .75-.75h10.638L10.23 5.29a.75.75 0 1 1 1.04-1.08l5.5 5.25a.75.75 0 0 1 0 1.08l-5.5 5.25a.75.75 0 1 1-1.04-1.08l4.158-3.96H3.75A.75.75 0 0 1 3 10Z" clip-rule="evenodd" />
          </svg>
        </a>
        <PhoneLink variant="cta" />
      </div>

      <div class="mt-8 flex items-center gap-6">
        <div class="flex -space-x-1">
          <span class="w-9 h-9 rounded-full bg-warm-100 border-2 border-white"></span>
          <span class="w-9 h-9 rounded-full bg-brand-200 border-2 border-white"></span>
          <span class="w-9 h-9 rounded-full bg-accent-300 border-2 border-white"></span>
        </div>
        <p class="text-sm text-ink-700">
          <span class="font-semibold">★ 4.9 average</span> ·
          '{brand.serviceArea[0]}' tenants who stop worrying about cleaning.
        </p>
      </div>
    </Reveal>

    <Reveal client:load delay={0.15}>
      <div class="space-y-4">
        <div
          class="rounded-card-lg bg-ink-900 text-white p-7
                 shadow-card-hover"
        >
          <p class="text-xs uppercase tracking-wider text-brand-300">
            Our guarantee
          </p>
          <p class="mt-3 font-display text-3xl">
            We answer within 30 minutes.
          </p>
          <p class="mt-2 text-sm text-ink-300 leading-relaxed">
            Phone, email, or WhatsApp — a real person picks up, takes
            notes, and a quote lands in your inbox same-day.
          </p>
        </div>

        <div class="grid grid-cols-3 gap-3">
          <div class="rounded-card bg-white border border-ink-200 p-5">
            <p class="font-display text-3xl text-ink-900">14+</p>
            <p class="text-xs text-ink-600 mt-1">years cleaning Winnipeg</p>
          </div>
          <div class="rounded-card bg-white border border-ink-200 p-5">
            <p class="font-display text-3xl text-ink-900">30m</p>
            <p class="text-xs text-ink-600 mt-1">response guarantee</p>
          </div>
          <div class="rounded-card bg-white border border-ink-200 p-5">
            <p class="font-display text-3xl text-ink-900">$2M</p>
            <p class="text-xs text-ink-600 mt-1">general liability</p>
          </div>
        </div>
      </div>
    </Reveal>
  </div>
</section>
