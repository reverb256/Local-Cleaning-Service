---
/**
 * Testimonials.astro — three-column quote grid on the home page.
 */
import { testimonials } from '~/content/testimonials';
import { Reveal } from '~/components/ui/Reveal.tsx';

const initials = (name: string) =>
  name
    .split(' ')
    .filter((part) => /^[A-Z]/.test(part))
    .slice(0, 2)
    .map((part) => part[0])
    .join('');
---

<section id="testimonials" class="bg-ink-50 border-y border-ink-200/70">
  <div class="container-page py-20 md:py-24">
    <Reveal client:load>
      <span class="eyebrow">What tenants say</span>
    </Reveal>

    <Reveal client:load delay={0.05}>
      <h2 class="mt-3 font-display text-3xl md:text-4xl text-ink-900 max-w-2xl">
        Honest words from three real Winnipeg accounts.
      </h2>
    </Reveal>

    <div class="mt-10 grid md:grid-cols-3 gap-5">
      {
        testimonials.map((t, idx) => (
          <Reveal client:load delay={0.05 * idx}>
            <figure class="surface-card p-7 h-full">
              <svg
                viewBox="0 0 24 24"
                fill="currentColor"
                class="w-7 h-7 text-brand-500"
                aria-hidden="true"
              >
                <path d="M9 7H5a2 2 0 0 0-2 2v4a2 2 0 0 0 2 2h2v2a4 4 0 0 1-4 4v2a6 6 0 0 0 6-6V9a2 2 0 0 0 0-2Zm10 0h-4a2 2 0 0 0-2 2v4a2 2 0 0 0 2 2h2v2a4 4 0 0 1-4 4v2a6 6 0 0 0 6-6V9a2 2 0 0 0 0-2Z" />
              </svg>
              <blockquote class="mt-3 text-ink-800 leading-relaxed text-[15px]">
                {t.quote}
              </blockquote>
              <figcaption class="mt-5 flex items-center gap-3">
                <span
                  class="inline-flex w-9 h-9 rounded-full bg-brand-100
                         text-brand-800 items-center justify-center
                         text-sm font-bold"
                  aria-hidden="true"
                >
                  {initials(t.name)}
                </span>
                <span>
                  <span class="block text-sm font-semibold text-ink-900">
                    {t.name}
                  </span>
                  <span class="block text-xs text-ink-600">
                    {t.role} · {t.org}
                  </span>
                </span>
              </figcaption>
            </figure>
          </Reveal>
        ))
      }
    </div>
  </div>
</section>
