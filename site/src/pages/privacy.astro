---
import BaseHead    from '~/components/layout/BaseHead.astro';
import Header      from '~/components/layout/Header.astro';
import Footer      from '~/components/layout/Footer.astro';
import SmoothScroll from '~/components/islands/SmoothScroll.tsx';
import { brand }   from '~/lib/brand';
---

<!doctype html>
<html lang="en-CA">
  <head>
    <BaseHead meta={{
      title: 'Privacy',
      description:
        'How Workplace Janitorial Services handles any information ' +
        'you send through this website. Plain-language summary.',
      path: '/privacy',
    }}
    breadcrumb={[
      { name: 'Home',    path: '/' },
      { name: 'Privacy', path: '/privacy' },
    ]} />
  </head>
  <body class="bg-white">
    <Header />
    <main id="main" class="container-page py-16 md:py-20 max-w-2xl">
      <span class="eyebrow">Privacy</span>
      <h1 class="mt-3 font-display text-3xl md:text-4xl text-ink-900">
        How we handle your information.
      </h1>

      <p class="mt-6 text-ink-700 leading-relaxed">
        We run a small commercial-cleaning business. We don't have a
        marketing automation platform, we don't have analytics
        tracking, and we don't have a CRM learning your habits. The
        only data we collect is what you write to us directly.
      </p>

      <h2 class="mt-8 font-display text-xl text-ink-900">What we keep</h2>
      <p class="mt-2 text-ink-700 leading-relaxed">
        If you send us a message through the contact form or email,
        we keep the contents of that message in our inbox for as long
        as the conversation is active. After the work is done, we
        keep quotes and invoices (we have to, by law). We do not
        keep anything else.
      </p>

      <h2 class="mt-8 font-display text-xl text-ink-900">What we don't do</h2>
      <p class="mt-2 text-ink-700 leading-relaxed">
        We don't trade, rent, or sell customer information. We don't
        run ad-tech retargeting, third-party analytics, or session
        recordings. We don't track visitors across the site. The only
        cookies on this site are functional — e.g. remembering your
        last quote estimate on the calculator page, stored locally in
        your browser.
      </p>

      <h2 class="mt-8 font-display text-xl text-ink-900">If we change this</h2>
      <p class="mt-2 text-ink-700 leading-relaxed">
        We'll update this page, and we'll post the change at the top
        of our company-newsletter if it is material. If you'd like
        to be notified by email instead, ask at{' '}
        <a
          class="font-semibold text-brand-700 underline"
          href={`mailto:${brand.email}`}>{brand.email}</a>.
      </p>

      <h2 class="mt-8 font-display text-xl text-ink-900">
        Questions or corrections
      </h2>
      <p class="mt-2 text-ink-700 leading-relaxed">
        Reach us at{' '}
        <a
          class="font-semibold text-brand-700 underline"
          href={`mailto:${brand.email}`}>{brand.email}</a>{' '}or call{' '}
        <a
          class="font-semibold text-brand-700 underline"
          href={`tel:${brand.phone.tel}`}>{brand.phone.display}</a>.
        We will respond within one business day.
      </p>

      <p class="mt-10 text-xs text-ink-500">
        Last updated 2026-07-01.
      </p>
    </main>
    <Footer />

    <SmoothScroll client:idle />
  </body>
</html>
