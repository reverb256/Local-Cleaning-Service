---
import BaseHead        from '~/components/layout/BaseHead.astro';
import Header          from '~/components/layout/Header.astro';
import Footer          from '~/components/layout/Footer.astro';
import PhoneLink       from '~/components/ui/PhoneLink.astro';
import SmoothScroll    from '~/components/islands/SmoothScroll.tsx';
import QuoteCalculator from '~/components/islands/QuoteCalculator.tsx';
---

<!doctype html>
<html lang="en-CA">
  <head>
    <BaseHead meta={{
      title: 'Get a quote',
      description:
        'A 30-second estimate for office, medical, retail, or ' +
        'post-construction cleaning. No email required, no phone tag.',
      path: '/quote',
    }}
    breadcrumb={[
      { name: 'Home',        path: '/' },
      { name: 'Get a quote', path: '/quote' },
    ]} />
  </head>
  <body class="bg-white">
    <Header />
    <main id="main">
      <section class="container-page pt-16 pb-4 md:pt-20">
        <span class="eyebrow">Get a 30-second estimate</span>
        <h1 class="mt-3 font-display text-4xl md:text-5xl text-ink-900 max-w-3xl">
          Three fields, no phone tag.
        </h1>
        <p class="mt-5 text-lg text-ink-700 max-w-2xl leading-relaxed">
          Pick a service, enter an approximate area, pick a frequency.
          We'll show a credible price range — no email requested.
          When you're ready, we lock the number in on a 20-minute
          walk-through.
        </p>
      </section>

      <section class="container-page pb-20">
        <QuoteCalculator client:visible />
      </section>

      <section class="container-page pb-20">
        <p class="text-sm text-ink-600 max-w-2xl">
          Prefer to talk it through?{' '}
          <PhoneLink variant="inline" />{' '}or{' '}
          <a
            href="/contact"
            class="font-semibold text-brand-700 underline underline-offset-4 decoration-2"
          >send a message</a>.
        </p>
      </section>
    </main>
    <Footer />

    <SmoothScroll client:idle />
    <PhoneLink variant="sticky" />
  </body>
</html>
