---
import BaseHead    from '~/components/layout/BaseHead.astro';
import Header      from '~/components/layout/Header.astro';
import Footer      from '~/components/layout/Footer.astro';
import AboutPanel  from '~/components/sections/AboutPanel.astro';
import PhoneLink   from '~/components/ui/PhoneLink.astro';
import SmoothScroll from '~/components/islands/SmoothScroll.tsx';
---

<!doctype html>
<html lang="en-CA">
  <head>
    <BaseHead meta={{
      title: 'About',
      description:
        'Workplace Janitorial Services — a bonded, WCB-covered ' +
        'Winnipeg commercial-cleaning company operating since 2010. ' +
        'A flat team of 14, same owner-operator on every walk-through.',
      path: '/about',
    }}
    breadcrumb={[
      { name: 'Home',  path: '/' },
      { name: 'About', path: '/about' },
    ]} />
  </head>
  <body class="bg-white">
    <Header />
    <main id="main">
      <section class="container-page pt-16 pb-4 md:pt-20">
        <span class="eyebrow">About</span>
        <h1 class="mt-3 font-display text-4xl md:text-5xl text-ink-900 max-w-3xl">
          A small Winnipeg team that takes cleaning personally.
        </h1>
      </section>
      <AboutPanel />
    </main>
    <Footer />

    <SmoothScroll client:idle />
    <PhoneLink variant="sticky" />
  </body>
</html>
